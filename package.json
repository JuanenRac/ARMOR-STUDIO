{
  "name": "armor-studio",
  "private": true,
  "version": "0.8.2.3",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint src",
    "locales": "node tools/build_locales.mjs",
    "locales:check": "node tools/build_locales.mjs --check",
    "locales:report": "node tools/i18n_report.mjs",
    "locales:report:ci": "node tools/i18n_report.mjs --limits --github"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
